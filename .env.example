# ============================================================
# Investorlogical — environment variables
# Copy to .env.local for local dev. Set the same vars in Vercel
# (and in the Claude Code environment settings so agent sessions
# can run integration checks).
# ============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for service-role operations (Inngest jobs, runAgent).
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Public origin of the deployed app. Magic-link emails redirect here —
# without it, links point at localhost. e.g. https://investorlogical.com
NEXT_PUBLIC_APP_URL=

# ---- Auth ----
# OWNER list (comma-separated): the admin/bootstrap identities that can run
# Setup and APPROVE other users. Changes rarely (a redeploy for a new owner is
# fine). Everyday users are NOT listed here — they request access on the login
# page and the owner approves them with one click in Setup, which writes an
# app_users row (the live allowlist). e.g. AUTH_ALLOWED_EMAIL=owner@example.com
AUTH_ALLOWED_EMAIL=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# Model TIERS are pinned in lib/anthropic/client.ts; override only if needed.
# ANTHROPIC_MODEL_ROUTINE=claude-sonnet-5
# ANTHROPIC_MODEL_DEEP=claude-opus-4-8

# ---- Inngest ----
# Required in production — /api/inngest fails closed without the signing key.
# Local dev uses the Inngest dev server with no keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Data sources ----
# Twelve Data — PRIMARY price source. A keyed REST API that serves history from
# datacenter IPs (unlike scraped Yahoo/Stooq). Free "Basic" tier is US-only;
# LSE/London needs the paid "Grow" plan. Key at https://twelvedata.com/pricing
TWELVEDATA_API_KEY=
# Requests are spaced to this plan limit (credits/min). Free Basic = 8;
# Grow = 377. Leave unset for the safe free-tier default.
TWELVEDATA_CREDITS_PER_MIN=
# Finnhub — fundamentals + fallback. Its free tier paywalls price candles
# entirely, so it is no longer the price primary. Free key at https://finnhub.io
FINNHUB_API_KEY=
# SEC EDGAR requires a User-Agent identifying the requester.
SEC_EDGAR_USER_AGENT="investorlogical/0.1 (contact email here)"
# FRED — free, register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Companies House — free, register at https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# Paid adapters — scaffolded behind interfaces in PR 2 but not used in v1.
# FMP_API_KEY=
# POLYGON_API_KEY=
# MARKETAUX_API_KEY=

# ---- Email (holding alerts) ----
# Postmark — the MXMG family's transactional provider. Server token (from the
# Postmark server's API Tokens tab) + a verified sender signature/domain.
# Leave unset to disable alert emails entirely (runs are unaffected).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
# Optional; defaults to "outbound" (Postmark's default transactional stream).
# POSTMARK_MESSAGE_STREAM=outbound

# ---- Dev tooling ----
# Required to use /api/dev/ingest in production (sent as x-dev-ingest-secret
# header). Leave unset to disable the route in production entirely.
DEV_INGEST_SECRET=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# GBP for report totals/yields, native currency at the security level.
BASE_CURRENCY=GBP
