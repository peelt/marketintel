# ============================================================
# marketintel — environment variables
# Copy to .env.local for local dev. Set the same vars in Vercel.
# ============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for service-role operations (Inngest jobs, migrations).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth ----
# Single-user: only this email can complete the magic-link login.
AUTH_ALLOWED_EMAIL=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# Defaults baked into the client; override only if needed.
# ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-5
# ANTHROPIC_MODEL_DEEP=claude-opus-4-7

# ---- Inngest ----
# Required in production. Local dev uses the Inngest dev server with no keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Data sources (free tier only for v1; paid keys scaffolded but unused) ----
# SEC EDGAR requires a User-Agent identifying the requester.
SEC_EDGAR_USER_AGENT="marketintel/0.1 (peel@mxmg.co.uk)"
# FRED — free, register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Paid adapters — scaffolded behind interfaces in PR 2 but not used in v1.
# FMP_API_KEY=
# POLYGON_API_KEY=
# MARKETAUX_API_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# GBP for report totals/yields, native currency at the security level.
BASE_CURRENCY=GBP
